generator client {
  provider = "prisma-client-js"
}

// SQLite is the local development provider. For PostgreSQL, change provider to
// "postgresql" and set DATABASE_URL to the PostgreSQL connection string.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model role {
  id          Int      @id @default(autoincrement())
  nombre      String   @unique // "JEFE_COMUNIDAD", "JEFE_CALLE", "HABITANTE"
  descripcion String?  @default("sin descripcion")
  borrado     Boolean  @default(false)
  updatedAt   DateTime @default(now())
  createdAt   DateTime @default(now())

  usuarios     usuario[]     @relation(name: "UsuarioRole")
  inviteTokens inviteToken[]
}

model usuario {
  id           Int       @id @default(autoincrement())
  cedula       String    @unique
  nombre       String
  nombre_dos   String?   @default("")
  apellido     String?
  apellido_dos String?   @default("")
  f_n          DateTime?
  genero       Boolean
  telefono     String?
  correo       String?   @unique
  clave        String?
  token        String    @unique
  borrado      Boolean   @default(false)
  validado     Boolean   @default(false)
  rolId        Int
  usuarioId    Int? // ID del Jefe de Comunidad / Jefe de Calle que lo registró
  comunaId     Int
  calleId      Int?
  familiaId    Int? // Opcional: vinculación directa a una familia/hogar

  updatedAt DateTime @default(now())
  createdAt DateTime @default(now())

  // Relaciones Prisma
  roles            role      @relation(name: "UsuarioRole", fields: [rolId], references: [id])
  creador          usuario?  @relation(name: "CreadorUsuarios", fields: [usuarioId], references: [id])
  usuarios_creados usuario[] @relation(name: "CreadorUsuarios")
  comuna           comuna    @relation(fields: [comunaId], references: [id])
  calle            calle?    @relation(fields: [calleId], references: [id])
  familia          familia?  @relation(fields: [familiaId], references: [id], onDelete: SetNull)

  sentInvitations     inviteToken[] @relation("CreadorInvitacion")
  acceptedInvitations inviteToken[] @relation("AceptorInvitacion")
  imagenes            imagen[]

  @@index([rolId])
  @@index([comunaId])
  @@index([calleId])
  @@index([familiaId])
}

model comuna {
  id        Int      @id @default(autoincrement())
  nombre    String   @unique
  codigo    String?  @unique
  estado    String
  municipio String
  parroquia String
  borrado   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usuarios     usuario[]
  calles       calle[]
  invitaciones inviteToken[]
}

model calle {
  id        Int      @id @default(autoincrement())
  nombre    String
  numero    Int?
  direccion String?
  borrado   Boolean  @default(false)
  comunaId  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comuna       comuna        @relation(fields: [comunaId], references: [id], onDelete: Cascade)
  usuarios     usuario[]
  familias     familia[]
  invitaciones inviteToken[]

  @@unique([comunaId, nombre])
}

model familia {
  id                   Int      @id @default(autoincrement())
  nombre               String // Ej: "Familia Pérez"
  codigo               String   @unique
  direccion            String
  tipoVivienda         String?
  numero               Int
  discapacidad         Boolean  @default(false)
  detallesDiscapacidad String?
  servicioAgua         Boolean  @default(false)
  electricidad         Boolean  @default(false)
  observacion          String?
  borrado              Boolean  @default(false)
  calleId              Int
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  calle       calle     @relation(fields: [calleId], references: [id], onDelete: Cascade)
  integrantes usuario[] // Todos los habitantes/personas registradas en esta familia

  @@index([calleId])
}

model imagen {
  id             Int      @id @default(autoincrement())
  path           String
  nombreOriginal String
  nombreSistema  String
  tipo           String
  formato        String
  peso           Int
  perfil         Boolean  @default(true)
  borrado        Boolean  @default(false)
  usuarioId      Int
  updatedAt      DateTime @default(now())
  createdAt      DateTime @default(now())

  usuario usuario @relation(fields: [usuarioId], references: [id])
}

model inviteToken {
  id              Int       @id @default(autoincrement())
  token           String    @unique
  correo          String
  expireAt        DateTime
  usadoAt         DateTime?
  borrado         Boolean   @default(false)
  usuarioInvitaId Int
  usuarioAceptaId Int?
  rolId           Int
  comunaId        Int?
  calleId         Int?
  updatedAt       DateTime  @default(now())
  createdAt       DateTime  @default(now())

  rol           role     @relation(fields: [rolId], references: [id])
  usuarioInvita usuario  @relation("CreadorInvitacion", fields: [usuarioInvitaId], references: [id], onDelete: Cascade)
  usuarioAcepta usuario? @relation("AceptorInvitacion", fields: [usuarioAceptaId], references: [id], onDelete: SetNull)
  comuna        comuna?  @relation(fields: [comunaId], references: [id], onDelete: SetNull)
  calle         calle?   @relation(fields: [calleId], references: [id], onDelete: SetNull)

  @@index([correo])
  @@index([expireAt])
}

model eventos {
  id           Int      @id @default(autoincrement())
  tabla        String
  accion       String
  ip           String?  @default("") // Dirección IP del usuario
  descripcion  String?  @default("")
  datosAntes   Json? // Datos anteriores (UPDATE o DELETE)
  datosDespues Json? // Datos nuevos (INSERT o UPDATE)
  borrado      Boolean  @default(false)
  id_objeto    Int
  id_usuario   Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
